。今季は近本の離脱時にセンターのレギュラーを務めるなど、リーグ連覇に欠かせない貢献を見せた。現在は主力の故障が相次いでいるだけに、チームを救う活躍に期待がかかる。","lineups":{"away":{"team":"요코하마 DeNA 베이스타스","players":[{"order":1,"name":"와타라이 류키","pid":"1850873","pos":"좌익수"},{"order":2,"name":"마키 슈고","pid":"2000035","pos":"2루수"},{"order":3,"name":"사노 케이타","pid":"1600089","pos":"1루수"},{"order":4,"name":"미야자키 토시로","pid":"1200053","pos":"3루수"},{"order":5,"name":"엔카나시온","pid":"2108195","pos":"우익수"},{"order":6,"name":"후루이치 타케루","pid":"2103949","pos":"포수"},{"order":7,"name":"나루세 슈토","pid":"2115069","pos":"유격수"},{"order":8,"name":"에비나 타츠오","pid":"1900035","pos":"중견수"},{"order":9,"name":"아즈마 카츠키","pid":"1700058","pos":"투수"}]},"home":{"team":"한신 타이거스","players":[{"order":1,"name":"치카모토 코지","pid":"1800065","pos":"중견수"},{"order":2,"name":"나카노 타쿠무","pid":"2000056","pos":"2루수"},{"order":3,"name":"모리시타 쇼타","pid":"1850183","pos":"우익수"},{"order":4,"name":"사토 테루아키","pid":"2000051","pos":"3루수"},{"order":5,"name":"오야마 유스케","pid":"1600113","pos":"1루수"},{"order":6,"name":"후시미 토라이","pid":"1200100","pos":"포수"},{"order":7,"name":"타카테라 노조무","pid":"2000057","pos":"좌익수"},{"order":8,"name":"쿠마가이 타카히로","pid":"1700079","pos":"유격수"},{"order":9,"name":"오타케 코타로","pid":"1700137","pos":"투수"}]}},"innings":[{"inning":1,"half":"초","team":"요코하마 DeNA 베이스타스","events":[{"no":"1","order":"1번","batter":"와타라이 류키","situation":"무사 주자 없음","lines":[{"t":"바깥쪽 직구를 쳤지만 우익수 플라이","k":"","tail":"1아웃"}]},{"no":"2","order":"2번","batter":"마키 슈고","situation":"1사 주자 없음","lines":[{"t":"좌전 안타로 출루","k":"","tail":"주자 1루"}]},{"no":"3","order":"3번","batter":"사노 케이타","situation":"1사 1루","lines":[{"t":"1루 견제: 주자 마키 슈고 귀루","k":""},{"t":"우전 안타","k":"","tail":"주자 1·3루"}]},{"no":"4","order":"4번","batter":"미야자키 토시로","situation":"1사 1·3루","lines":[{"t":"1사 1·3루, 볼카운트 1-1에서 희생플라이","k":"point"},{"t":"DeNA선제!","k":"point","tail":"2아웃 · 주자 1루","score":"한신 0 : 1 DeNA"}]},{"no":"5","order":"5번","batter":"엔카나시온","situation":"2사 1루","lines":[{"t":"좌익수 쪽 2루타","k":""},{"t":"1루 주자 사노 케이타는 주루사","k":"","tail":"3아웃 공수교대"}]}],"summa