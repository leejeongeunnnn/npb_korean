るDeNAは筒香のバットに期待。このシリーズでは第1戦でマルチ安打の活躍を見せると、第2戦では一時逆転となる3ランを放っている。この試合でも快音を響かせ、打線を勢いづけたいところだ。","lineups":{"away":{"team":"요코하마 DeNA 베이스타스","players":[{"order":1,"name":"와타라이 류키","pid":"1850873","pos":"좌익수"},{"order":2,"name":"마키 슈고","pid":"2000035","pos":"2루수"},{"order":3,"name":"사노 케이타","pid":"1600089","pos":"1루수"},{"order":4,"name":"츠츠고 요시토모","pid":"1000002","pos":"3루수"},{"order":5,"name":"미야자키 토시로","pid":"1200053","pos":"지명타자"},{"order":6,"name":"미모리 마사키","pid":"1600167","pos":"중견수"},{"order":7,"name":"이노에 토모야","pid":"2000108","pos":"우익수"},{"order":8,"name":"후루이치 타케루","pid":"2103949","pos":"포수"},{"order":9,"name":"나루세 슈토","pid":"2115069","pos":"유격수"}]},"home":{"team":"소프트뱅크 호크스","players":[{"order":1,"name":"마사키 토모야","pid":"2103735","pos":"우익수"},{"order":2,"name":"슈토 우쿄","pid":"1700135","pos":"중견수"},{"order":3,"name":"콘도 켄스케","pid":"1100097","pos":"좌익수"},{"order":4,"name":"쿠리하라 료야","pid":"1400127","pos":"3루수"},{"order":5,"name":"야나기타 유키","pid":"1000128","pos":"지명타자"},{"order":6,"name":"야마카와 호타카","pid":"1300101","pos":"1루수"},{"order":7,"name":"마키하라 타이세이","pid":"1000175","pos":"2루수"},{"order":8,"name":"우미노 타카시","pid":"1900101","pos":"포수"},{"order":9,"name":"쇼지 유다이","pid":"1950149","pos":"유격수"}]}},"innings":[{"inning":1,"half":"초","team":"요코하마 DeNA 베이스타스","events":[{"no":"4","order":"4번","batter":"츠츠고 요시토모","situation":"2사 2루","lines":[{"t":"꼼짝 못 하고 루킹 삼진! 찬스를 놓침","k":"","tail":"3아웃 공수교대"}]},{"no":"3","order":"3번","batter":"사노 케이타","situation":"1사 2루","lines":[{"t":"헛스윙 삼진","k":"","tail":"2아웃"}]},{"no":"2","order":"2번","batter":"마키 슈고","situation":"1사 주자 없음","lines":[{"t":"2루타","k":"","tail":"주자 2루"}]},{"no":"1","order":"1번","batter":"와타라이 류키","situation":"무사 주자 없음","lines":[{"t":"투수 땅볼","k":"","tail":"1아웃"}]}],"summary":{"r":"0","h":"1","bb":"0"}},{"inning":1,"half":"말","team":"소프트뱅크 호크스","events":[{"no":"3","order":"3번","batter":"콘도 켄스케","situation":"2사 주자 없음","lines":[{"t":"바깥쪽 낮은 공을 쳤지만 좌익수 플라이","k":"","tail":"3아웃 공수교대"}]},{"no":"2","order":"2번","batter":"슈토 우쿄","